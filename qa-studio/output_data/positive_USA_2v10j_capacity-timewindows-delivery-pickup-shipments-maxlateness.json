[
  {
    "testCaseId": "TC-RO-POS-001",
    "feature": "Vehicle Start Index",
    "title": "Vehicle begins route at start_index 0",
    "description": "A vehicle anchored at start_index 0 begins its route at that coordinate and serves a feasible job.",
    "testData": {
      "locations": { "location": ["34.0522, -118.2437", "37.3382, -121.8863"] },
      "vehicles": [{ "id": "V1", "start_index": 0 }],
      "jobs": [{ "id": "J1", "location_index": 1 }]
    },
    "details": { "features": ["vehicles.start_index", "jobs.location_index"], "archetype": "positive" },
    "expectedResult": "200; result.code==0; V1 route starts at location_index 0; J1 assigned; result.unassigned empty",
    "priority": "P2",
    "type": "Positive"
  },
  {
