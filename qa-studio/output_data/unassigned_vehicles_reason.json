[
  {
    "testCaseId": "TC-RO-POS-001",
    "feature": "Report Unused Vehicle Reason",
    "title": "Option disabled (regression): unused_vehicles absent when flag is false or unset",
    "description": "When report_unused_vehicle_reason is false or omitted, result.unused_vehicles must not be present, even with unassigned tasks.",
    "testData": {
      "locations": {
        "location": [
          "17.542688621652715, 78.48238524451742",
          "17.50003960866327, 78.35676430991286",
          "17.48289435342982, 78.59553394476931",
          "17.493623860767304, 78.35567233615696",
          "17.500887651591093, 78.58875886923576"
        ]
      },
      "vehicles": [
        {"id": "V1", "start_index": 0, "end_index": 0, "capacity": [100], "time_window": [1785825600, 1785865200]},
        {"id": "V2", "start_index": 0, "end_index": 0, "capacity": [100], "time_window": [1785825600, 1785865200]}
      ],
      "jobs": [
        {"id": "J1", "location_index": 1, "delivery": [40]},
        {"id": "J2", "location_index": 2, "delivery": [50]}
      ],
      "options": {
        "report_unused_vehicle_reason": false
      }
    },
    "details": {
      "features": ["options.report_unused_vehicle_reason"],
      "archetype": "positive"
    },
    "expectedResult": "200; result.code==0; unused_vehicles field must not be present in result",
    "priority": "P2",
    "type": "Positive",
    "draft": true
  },
