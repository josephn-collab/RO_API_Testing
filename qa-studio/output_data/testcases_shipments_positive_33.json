[
  {
    "testCaseId": "TC-RO-POS-001",
    "feature": "Vehicle Start Index",
    "title": "Vehicle begins route at start_index 0",
    "description": "A vehicle anchored at start_index 0 serves one shipment.",
    "testData": {
      "locations": {
        "location": [
          "34.0522, -118.2437",
          "37.3382, -121.8863",
          "47.6062, -122.3321"
        ]
      },
      "vehicles": [
        {
          "id": "V1",
          "start_index": 0,
          "end_index": 0
        }
      ],
      "shipments": [
        {
          "pickup": {
            "id": "S1P",
            "location_index": 1
          },
          "delivery": {
            "id": "S1D",
            "location_index": 2
          }
        }
      ]
    },
    "details": {
      "features": [
        "vehicles.start_index"
      ],
      "archetype": "positive"
    },
    "expectedResult": "200; status Ok; result.code==0; shipment S1 assigned; result.unassigned empty",
    "priority": "P2",
    "type": "Positive"
  },
